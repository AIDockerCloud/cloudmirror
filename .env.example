# bw_sync 环境变量配置示例（请勿将真实密码提交至版本控制库）
# 复制为 .env 并填写：cp .env.example .env && chmod 600 .env

# 必需：两边保险库主密码（运行与解密必需）
BW_SYNC_NODE_PASSWORD=your_nodewarden_master_password
BW_SYNC_VAULT_PASSWORD=your_vaultwarden_master_password

# 可选：云端无人值守个人 API Key（设置后优先使用 API Key 登录，仍需主密码解密）
# BW_SYNC_NODE_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# BW_SYNC_NODE_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BW_SYNC_VAULT_CLIENTID=user.yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy
# BW_SYNC_VAULT_CLIENTSECRET=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# S3 对象存储凭据（用于 S3 跨云主备镜像同步与多云灾备，零密钥明文上盘）
# 推荐配合 S3 配置中的 access_key_env / secret_key_env 使用
# Cloudflare R2
# S3_R2_ACCESS_KEY=your_r2_access_key_id
# S3_R2_SECRET_KEY=your_r2_secret_access_key

# 缤纷云 Bitiful
# S3_BITIFUL_ACCESS_KEY=your_bitiful_access_key_id
# S3_BITIFUL_SECRET_KEY=your_bitiful_secret_access_key

# MinIO (私有 NAS / Docker)
# S3_MINIO_ACCESS_KEY=your_minio_access_key
# S3_MINIO_SECRET_KEY=your_minio_secret_key

# 腾讯云 COS
# S3_COS_ACCESS_KEY=your_tencent_cos_secret_id
# S3_COS_SECRET_KEY=your_tencent_cos_secret_key

# 阿里云 OSS
# S3_OSS_ACCESS_KEY=your_aliyun_oss_access_key_id
# S3_OSS_SECRET_KEY=your_aliyun_oss_access_key_secret

# AWS S3
# S3_AWS_ACCESS_KEY=your_aws_access_key_id
# S3_AWS_SECRET_KEY=your_aws_secret_access_key

