# bw_sync 环境变量配置示例（请勿将真实密码提交至版本控制库）
# 复制为 .env 并填写：cp .env.example .env && chmod 600 .env

# 必需：两边保险库主密码（运行与解密必需）
BW_SYNC_NODE_PASSWORD=your_nodewarden_master_password
BW_SYNC_VAULT_PASSWORD=your_vaultwarden_master_password

# 可选：云端无人值守个人 API Key（设置后优先使用 API Key 登录，仍需主密码解密）
# BW_SYNC_NODE_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# BW_SYNC_NODE_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BW_SYNC_VAULT_CLIENTID=user.yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy
# BW_SYNC_VAULT_CLIENTSECRET=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
